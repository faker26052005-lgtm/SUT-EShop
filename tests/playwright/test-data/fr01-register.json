    "password": "ValidPass 123",
    "checkConfirmField": false,
    "expected": {
      "outcome": "error_banner",
      "expectedUrl": "/register",
      "bugNote": "SUT does not trim whitespace-only name and allows registration"
    }
  },
  {
    "id": "TC-FR01-04",
