    "password": "ValidPass 123",
    "checkConfirmField": false,
    "expected": {
      "outcome": "error_banner",
      "expectedUrl": "/register",
      "bugNote": "SUT lacks alphabetic character validation for Name"
    }
  },
  {
    "id": "TC-FR01-05",
    "category": "Edge",
    "title": "XSS payload in Name should be rejected or safely neutralized",
    "name": "<script>alert(1)</script>",
    "email": "xssname_{{ts}}@gmail.com",
    "password": "ValidPass 123",
    "checkConfirmField": false,
    "expected": {
      "outcome": "error_banner",
      "expectedUrl": "/register",
      "bugNote": "SUT accepts raw script tags in Name; Header renders with dangerouslySetInnerHTML"
    }
  },
