# ==============================================================================
# Comprehensive .gitignore for SUT-EShop & Seminar Projects
# Covers: Backend (Node.js/Express/SQLite), Frontend Web/Admin (React/Vite/Tailwind),
#         Frontend Mobile (React Native/Expo), Testing Tools & Frameworks,
#         Operating Systems, and IDEs/Code Editors.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependency Directories
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 2. Production & Build Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
web-build/
.next/
.nuxt/

# ------------------------------------------------------------------------------
# 3. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
*.env
!*.env.example

# ------------------------------------------------------------------------------
# 4. Logs, Runtime & Debugging
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 5. Database & Local Storage (SQLite / Embedded DBs)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal

# ------------------------------------------------------------------------------
# 6. Frontend / Bundler Caches & Metadata
# ------------------------------------------------------------------------------
.cache/
.vite/
.eslintcache
.stylelintcache
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 7. Mobile (React Native & Expo) Artifacts
# ------------------------------------------------------------------------------
.expo/
.expo-shared/
expo-env.d.ts
.metro-health-check*
metro-cache/

# Generated native directories (when running expo prebuild / run commands)
/ios/
/android/
android/.gradle/
android/app/build/
ios/build/
ios/Pods/
.kotlin/

# Mobile certificates, keystores, and distribution builds
*.jks
*.p8
*.p12
*.key
*.keystore
*.mobileprovision
*.pem
*.apk
*.aab
*.ipa
*.orig.*

# ------------------------------------------------------------------------------
# 8. Software Testing & QA Artifacts
# ------------------------------------------------------------------------------
# Test coverage (Jest, Vitest, Mocha, Istanbul, NYC)
coverage/
.nyc_output/

# End-to-End & Browser testing (Playwright, Cypress, Selenium)
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# API Testing & Test Runner Reports (Newman, Allure, JUnit)
newman/
reports/*.html
allure-results/
allure-report/
junit.xml

# Performance testing (k6, JMeter)
*.jtl
jmeter.log

# ------------------------------------------------------------------------------
# 9. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 10. IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
# Visual Studio Code (ignore everything except team configuration templates)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, WebStorm, Android Studio)
.idea/
*.iml
*.iws
*.ipr

# Vim, Neovim, Emacs, and temp swap files
*.swp
*.swo
*.sw?
*.bak
*.tmp
*.temp
.#*
*#

# ------------------------------------------------------------------------------
# 11. Java, Maven & Karate Framework Artifacts
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
karate.log*
karate-reports/

