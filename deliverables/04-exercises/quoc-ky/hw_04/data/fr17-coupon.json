  {
    "id": "TC_FR17_36",
    "title": "Validate race condition handling when creating duplicate coupon codes simultaneously",
    "type": "edge",
    "automation_decision": "automate_expected_failure",
    "test_layer": "api",
    "defect_id": "BUG-FR17-01",
    "code": "FLASH50",
    "discount_type": "percent",
    "discount_value": 10,
    "concurrency_requests": 2,
    "expected": {
      "valid_response_statuses": [
        200,
        201,
        400,
        409
      ],
      "db_record_count": 1,
      "unique_enforced": true
    },
    "notes": "Gửi đồng thời 2 request tạo cùng mã qua Promise.all(). CSDL lưu đúng 1 bản ghi (Pass), nhưng SUT văng HTTP 500 thay vì 400/409 (Fail). Promise.all() kiểm tra việc gửi đồng thời phía client, không đảm bảo lockstep concurrency ở critical section tầng DB."
  }
]