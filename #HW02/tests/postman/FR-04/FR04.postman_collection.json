          ]
        },
        {
          "name": "A3. Baseline: đặt hồ sơ gốc",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Ten Goc\",\"phone\":\"0900000000\",\"shipping_address\":\"Dia chi goc\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "A4. GET trước khi test",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('before', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "A5. PUT cần test (body lấy từ data file)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.iterationData.get('id');",
                  "if (!id) { throw new Error('Chưa nạp FR04_testdata.json trong Runner (mục Data). Hãy chọn file dữ liệu rồi chạy lại.'); }",
                  "let b = pm.iterationData.get('body');",
                  "if (typeof b === 'string') { b = JSON.parse(b); }",
                  "pm.request.body.update({ mode: 'raw', raw: JSON.stringify(b) });",
                  "const auth = pm.iterationData.get('auth') || 'valid';",
                  "if (auth === 'none') { pm.request.headers.remove('Authorization'); }",
                  "else if (auth === 'bad') { pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer abc.def.ghi' }); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('putStatus', String(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "A6. GET sau + chấm verdict",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = k => pm.iterationData.get(k);",
                  "const id = d('id'), desc = d('desc'), exp = d('expected');",
                  "let body = d('body'); if (typeof body === 'string') { body = JSON.parse(body); }",
                  "const before = JSON.parse(pm.collectionVariables.get('before'));",
                  "const after = pm.response.json();",
                  "const code = Number(pm.collectionVariables.get('putStatus'));",
                  "const email = pm.collectionVariables.get('email');",
                  "",
                  "const FIELDS = ['name', 'phone', 'shipping_address', 'email', 'role', 'id'];",
                  "const changed = FIELDS.filter(k => before[k] !== after[k]);",
                  "const ok2xx = code >= 200 && code < 300;",
                  "const is4xx = code >= 400 && code < 500;",
                  "const sent = ['name', 'phone', 'shipping_address'].filter(k => k in body);",
                  "const persisted = sent.every(k => after[k] === body[k]);",
                  "",
                  "let verdict;",
                  "switch (exp) {",
                  "  case 'OK':         verdict = ok2xx && persisted; break;",
                  "  case 'REJECT':     verdict = is4xx && changed.length === 0; break;",
                  "  case 'KEEP':       verdict = ok2xx && after.name === before.name && after.shipping_address === before.shipping_address && after.phone === body.phone; break;",
                  "  case 'EMAIL_SAME': verdict = after.email === email; break;",
                  "  case 'ROLE_USER':  verdict = after.role === 'user'; break;",
                  "  case 'ID_SAME':    verdict = after.id === before.id; break;",
                  "  case '401/403':    verdict = (code === 401 || code === 403) && changed.length === 0; break;",
                  "  default:           verdict = null;   // mong đợi '?' => CẦN LÀM RÕ, chỉ ghi nhận",
                  "}",
                  "",
                  "const label = `${id} | ${desc} | HTTP ${code}`;",
                  "if (verdict === null) {",
                  "  pm.test(`[CẦN LÀM RÕ] ${label} | hệ thống ${ok2xx ? 'CHẤP NHẬN' : 'TỪ CHỐI'}`, () => {});",
                  "} else {",
                  "  pm.test(label, () => {",
                  "    pm.expect(verdict, `expected=${exp}; trường bị đổi: ${JSON.stringify(changed)}`).to.be.true;",
                  "  });",
                  "}",
                  "",
                  "// Kiểm tra tác dụng phụ: trường KHÔNG gửi lên phải giữ nguyên",
                  "if (exp !== '401/403') {",
                  "  const wiped = ['name', 'phone', 'shipping_address'].filter(k => !(k in body) && before[k] !== after[k]);",
                  "  pm.test(`[SIDE-EFFECT] ${id} | trường không gửi phải giữ nguyên`, () => {",
                  "    pm.expect(wiped, `bị đổi ngoài ý muốn: ${wiped.join(', ')}`).to.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
