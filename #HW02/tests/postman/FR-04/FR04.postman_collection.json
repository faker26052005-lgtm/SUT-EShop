                "exec": [
                  "const email = `fr04.${Date.now().toString(16)}.${Math.floor(Math.random()*1e6)}@test.com`;",
                  "pm.collectionVariables.set('email', email);"
                ]
              }
            }
          ]
        },
        {
          "name": "A2. Login (lưu token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"Pass1234!\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let t = '';",
