         "body": {"code": "@js:delCode", "type": "percent", "discount_value": 5,
                  "min_order_amount": 0, "expired_at": "2099-12-31", "max_uses_per_user": 1}},
        {"js": "const listAfterCreate = await call('GET','/api/coupons',undefined,tok.admin); const created = listAfterCreate.json.find(c => c.code === delCode); ctx.delId = created ? created.id : null;"}
      ],
