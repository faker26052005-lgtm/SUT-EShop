    "user1": {"email": "test@eshop.com",  "password": "Test1234!"},
    "admin": {"email": "admin@eshop.com", "password": "Admin123!"}
  },
  "init_js": "const coupons = await call('GET','/api/coupons',undefined,tok.admin); ctx.initialCount = Array.isArray(coupons.json) ? coupons.json.length : 0;",

