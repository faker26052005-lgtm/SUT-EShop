    {
      "id": "DT-01",
      "technique": "DT",
      "req": "R1,R4,R5,R6,R7,R8,R9,R10",
      "title": "Tạo coupon hợp lệ — type percent (baseline)",
      "auth": "admin",
      "setup": [
        {"js": "const code01 = 'NEWTEST01_' + Date.now();"}
      ],
      "before": [
        {"as": "before_list", "method": "GET", "path": "/api/coupons", "auth": "admin"}
      ],
      "request": {"method": "POST", "path": "/api/admin/coupons", "body": {
        "code": "@js:code01",
        "type": "percent",
        "discount_value": 10,
        "min_order_amount": 200000,
        "expired_at": "2099-12-31",
        "max_uses_per_user": 1
      }},
      "expect": "success",
      "verify": [
        {"method": "GET", "path": "/api/coupons", "auth": "admin",
         "check": "Array.isArray(v.json) && v.json.some(c => c.code === code01)",
         "note": "coupon mới xuất hiện trong GET /api/coupons"},
        {"check": "r.json && (r.json.id || r.json.message)",
         "note": "response chứa id hoặc message thành công"}
      ]
    },

